    function populateTopicSelect() {
      const counts = {};
      QUESTIONS.forEach(q => {
        counts[q.assunto] = (counts[q.assunto] || 0) + 1;
      });
      Object.keys(counts).forEach(topic => {
        const opt = document.createElement("option");
        opt.value = topic;
        opt.textContent = `${topic} (${counts[topic]})`;
        topicSelect.appendChild(opt);
      });
    }

    function updateDashboardAndTopics() {
      const total = QUESTIONS.length;
      let correct = 0;
      let wrong = 0;

      const byTopic = {};
      QUESTIONS.forEach(q => {
        if (!byTopic[q.assunto]) {
          byTopic[q.assunto] = { total: 0, correct: 0, wrong: 0 };
        }
        byTopic[q.assunto].total++;

        const ans = userProgress[q.id];
        if (ans !== undefined && ans !== null) {
          if (ans === q.correta) {
            correct++;
            byTopic[q.assunto].correct++;
          } else {
            wrong++;
            byTopic[q.assunto].wrong++;
          }
        }
      });

      const answered = correct + wrong;
      const unanswered = total - answered;

      statAnswered.textContent = `${answered} / ${total}`;
      statCorrect.textContent = correct;
      statWrong.textContent = wrong;
      statUnanswered.textContent = unanswered;

      const correctOfAnswered = answered > 0 ? Math.round((correct / answered) * 100) : 0;
      const wrongOfAnswered = answered > 0 ? Math.round((wrong / answered) * 100) : 0;

      statCorrectPct.textContent = answered > 0 ? `${correctOfAnswered}% das respondidas` : "0% das respondidas";
      statWrongPct.textContent = answered > 0 ? `${wrongOfAnswered}% das respondidas` : "0% das respondidas";

      const pctDone = Math.round((answered / total) * 100);
      overallProgressLabel.textContent = `Progresso geral: ${pctDone}% concluído (${answered} de ${total})`;
      overallAccuracyLabel.textContent = answered > 0 ? `Aproveitamento: ${correctOfAnswered}% de acertos` : "Aproveitamento: —";

      overallGreenBar.style.width = `${(correct / total) * 100}%`;
      overallRedBar.style.width = `${(wrong / total) * 100}%`;

      // Highlight active status card
      document.querySelectorAll(".stat-card").forEach(card => {
        card.classList.toggle("active", card.dataset.statusFilter === statusFilter);
      });

      // Render topic breakdown cards
      topicBreakdownGrid.innerHTML = "";
      Object.entries(byTopic).forEach(([topic, st]) => {
        const tAns = st.correct + st.wrong;
        const cPct = tAns > 0 ? Math.round((st.correct / tAns) * 100) : 0;
        const wPct = tAns > 0 ? Math.round((st.wrong / tAns) * 100) : 0;

        const div = document.createElement("div");
        div.className = `topic-item ${topicFilter === topic ? "active" : ""}`;
        div.innerHTML = `
          <div class="topic-item-top">
            <span class="topic-name">${topic}</span>
            <span class="topic-count">${tAns}/${st.total}</span>
          </div>
          <div class="topic-stats-line">
            <span class="txt-green">✓ ${st.correct} (${cPct}%)</span>
            <span class="txt-red">✕ ${st.wrong} (${wPct}%)</span>
          </div>
          <div class="dual-bar" style="height: 6px;">
            <div class="dual-bar-green" style="width: ${(st.correct / st.total) * 100}%;"></div>
            <div class="dual-bar-red" style="width: ${(st.wrong / st.total) * 100}%;"></div>
          </div>
        `;
        div.addEventListener("click", () => {
          topicFilter = (topicFilter === topic) ? "all" : topic;
          topicSelect.value = topicFilter;
          renderAll();
        });
        topicBreakdownGrid.appendChild(div);
      });
    }

    function updateFilterBanner(filteredCount) {
      const labels = [];
      if (statusFilter === "correct") labels.push("Somente Acertos");
      if (statusFilter === "wrong") labels.push("Somente Erros");
      if (statusFilter === "unanswered") labels.push("Não Respondidas");
      if (topicFilter !== "all") labels.push(`Assunto: ${topicFilter}`);
      if (searchQuery.trim() !== "") labels.push(`Busca: "${searchQuery.trim()}"`);

      if (labels.length > 0) {
        activeFilterText.textContent = `Filtro ativo (${filteredCount} questões): ${labels.join(" • ")}`;
        activeFilterBanner.classList.add("visible");
      } else {
        activeFilterBanner.classList.remove("visible");
      }
    }

    function renderQuestions() {
      const qLower = searchQuery.trim().toLowerCase();

      const filtered = QUESTIONS.filter(q => {
        const ans = userProgress[q.id];
        const isAnswered = ans !== undefined && ans !== null;

        if (statusFilter === "correct" && (!isAnswered || ans !== q.correta)) return false;
        if (statusFilter === "wrong" && (!isAnswered || ans === q.correta)) return false;
        if (statusFilter === "unanswered" && isAnswered) return false;
        if (topicFilter !== "all" && q.assunto !== topicFilter) return false;

        if (qLower) {
          const hay = `${q.enunciado} ${q.assunto} ${q.referencia} ${q.alternativas.join(" ")}`.toLowerCase();
          if (!hay.includes(qLower)) return false;
        }
        return true;
      });

      updateFilterBanner(filtered.length);

      if (filtered.length === 0) {
        questionsContainer.innerHTML = `
          <div class="empty-state">
            <p style="font-weight: 700; font-size: 1rem; margin-bottom: 0.35rem;">Nenhuma questão encontrada com os filtros atuais.</p>
            <p style="font-size: 0.86rem;">Clique em "Limpar filtros" para voltar a visualizar todas as questões.</p>
          </div>
        `;
        return;
      }

      questionsContainer.innerHTML = "";
      filtered.forEach(q => {
        const ans = userProgress[q.id];
        const isAnswered = ans !== undefined && ans !== null;

        const card = document.createElement("article");
        card.className = "q-card";

        const optionsHtml = q.alternativas.map((altText, idx) => {
          let extraClass = "";
          let pillHtml = "";

          if (isAnswered) {
            if (idx === q.correta) {
              extraClass = "is-correct";
              pillHtml = `<span class="status-pill pill-correct">✓ Correta</span>`;
            } else if (idx === ans) {
              extraClass = "is-wrong-selected";
              pillHtml = `<span class="status-pill pill-wrong">✕ Incorreta</span>`;
            } else {
              extraClass = "is-dimmed";
            }
          }

          return `
            <button
              type="button"
              class="option-btn ${extraClass}"
              data-qid="${q.id}"
              data-idx="${idx}"
              ${isAnswered ? "disabled" : ""}
            >
              <span class="option-main">
                <span class="option-letter">${LETTERS[idx]}</span>
                <span>${altText}</span>
              </span>
              ${pillHtml}
            </button>
          `;
        }).join("");

        const justificationHtml = isAnswered ? `
          <div class="justification-box">
            <div class="justification-title">
              <span>💡 Justificativa & Comentário (Gabarito: ${LETTERS[q.correta]})</span>
              <button type="button" class="btn-sm redo-btn" data-qid="${q.id}">Refazer questão</button>
            </div>
            <div>${q.justificativa}</div>
          </div>
        ` : "";

        card.innerHTML = `
          <div class="q-header">
            <div class="q-badges">
              <span class="q-number">Questão #${q.id}</span>
              <span class="q-topic-badge">${q.assunto}</span>
            </div>
            <span class="q-ref">${q.referencia}</span>
          </div>
          <div class="q-stem">${q.enunciado}</div>
          <div class="options-list">${optionsHtml}</div>
          ${justificationHtml}
        `;

        questionsContainer.appendChild(card);
      });

      // Bind option click events
      questionsContainer.querySelectorAll(".option-btn:not(:disabled)").forEach(btn => {
        btn.addEventListener("click", () => {
          const qid = Number(btn.dataset.qid);
          const idx = Number(btn.dataset.idx);
          userProgress[qid] = idx;
          renderAll();
          syncToCloud();
        });
      });

      // Bind individual redo buttons
      questionsContainer.querySelectorAll(".redo-btn").forEach(btn => {
        btn.addEventListener("click", () => {
          const qid = Number(btn.dataset.qid);
          delete userProgress[qid];
          renderAll();
          syncToCloud();
        });
      });
    }

    function renderAll() {
      updateDashboardAndTopics();
      renderQuestions();
    }

    // =========================================================================
    // EVENT LISTENERS DE CONTROLE
    // =========================================================================
    document.querySelectorAll(".stat-card").forEach(card => {
      card.addEventListener("click", () => {
        const chosen = card.dataset.statusFilter;
        statusFilter = (statusFilter === chosen && chosen !== "all") ? "all" : chosen;
        renderAll();
      });
    });

    topicPanelToggle.addEventListener("click", () => {
      const isOpen = topicPanelBody.classList.toggle("open");
      topicPanelArrow.textContent = isOpen ? "Ocultar ▲" : "Mostrar ▼";
    });

    topicSelect.addEventListener("change", (e) => {
      topicFilter = e.target.value;
      renderAll();
    });

    searchInput.addEventListener("input", (e) => {
      searchQuery = e.target.value;
      renderQuestions();
    });

    clearFiltersBtn.addEventListener("click", () => {
      statusFilter = "all";
      topicFilter = "all";
      searchQuery = "";
      topicSelect.value = "all";
      searchInput.value = "";
      renderAll();
    });

    saveUserBtn.addEventListener("click", () => {
      const val = userIdInput.value.trim();
      if (!val) return;
      userId = val;
      localStorage.setItem(`simulado_user_${QUIZ_ID}`, userId);
      loadLocalProgress();
      renderAll();
      syncFromCloud();
    });

    userIdInput.addEventListener("keydown", (e) => {
      if (e.key === "Enter") saveUserBtn.click();
    });

    resetAllBtn.addEventListener("click", () => {
      if (confirm(`Deseja apagar todas as respostas salvas para o usuário "${userId}"?`)) {
        userProgress = {};
        renderAll();
        syncToCloud();
      }
    });

    // =========================================================================
    // INICIALIZAÇÃO
    // =========================================================================
    userIdInput.value = userId === "estudante_padrao" ? "" : userId;
    populateTopicSelect();
    loadLocalProgress();
    renderAll();
    syncFromCloud();
  </script>
</body>
