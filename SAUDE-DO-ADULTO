



<!DOCTYPE html>
<html lang="pt-BR" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Simulado Interativo • Saúde do Adulto (Banco Completo)</title>
  <style>
    :root {
      --bg-page: #f8fafc;
      --bg-card: #ffffff;
      --bg-subtle: #f1f5f9;
      --bg-hover: #e2e8f0;
      --border-color: #e2e8f0;
      --border-strong: #cbd5e1;
      --text-primary: #0f172a;
      --text-secondary: #334155;
      --text-muted: #64748b;
      --accent: #2563eb;
      --accent-hover: #1d4ed8;
      --accent-soft: #eff6ff;
      --green-bg: #dcfce7;
      --green-border: #16a34a;
      --green-text: #15803d;
      --green-bar: #22c55e;
      --red-bg: #fee2e2;
      --red-border: #dc2626;
      --red-text: #b91c1c;
      --red-bar: #ef4444;
      --amber-bg: #fef3c7;
      --amber-text: #b45309;
      --shadow-sm: 0 1px 2px rgba(15, 23, 42, 0.05);
      --shadow-md: 0 4px 12px rgba(15, 23, 42, 0.06);
      --radius-lg: 14px;
      --radius-md: 10px;
      --radius-sm: 8px;
    }

    [data-theme="dark"] {
      --bg-page: #0f172a;
      --bg-card: #1e293b;
      --bg-subtle: #0f172a;
      --bg-hover: #334155;
      --border-color: #334155;
      --border-strong: #475569;
      --text-primary: #f8fafc;
      --text-secondary: #e2e8f0;
      --text-muted: #94a3b8;
      --accent: #3b82f6;
      --accent-hover: #60a5fa;
      --accent-soft: rgba(59, 130, 246, 0.16);
      --green-bg: rgba(34, 197, 94, 0.15);
      --green-border: #22c55e;
      --green-text: #4ade80;
      --green-bar: #22c55e;
      --red-bg: rgba(239, 68, 68, 0.15);
      --red-border: #ef4444;
      --red-text: #f87171;
      --red-bar: #ef4444;
      --amber-bg: rgba(245, 158, 11, 0.16);
      --amber-text: #fbbf24;
      --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.25);
      --shadow-md: 0 6px 16px rgba(0, 0, 0, 0.3);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Inter, Helvetica, Arial, sans-serif;
      background-color: var(--bg-page);
      color: var(--text-primary);
      line-height: 1.6;
      transition: background-color 0.2s ease, color 0.2s ease;
      padding-bottom: 4rem;
    }

    .container {
      max-width: 1020px;
      margin: 0 auto;
      padding: 0 1rem;
    }

    /* Top Header */
    .topbar {
      position: sticky;
      top: 0;
      z-index: 40;
      background: var(--bg-card);
      border-bottom: 1px solid var(--border-color);
      box-shadow: var(--shadow-sm);
    }

    .topbar-inner {
      max-width: 1020px;
      margin: 0 auto;
      padding: 0.75rem 1rem;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 0.65rem;
    }

    .brand-icon {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      background: var(--accent);
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 1rem;
      flex-shrink: 0;
    }

    .brand-title {
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--text-primary);
      line-height: 1.2;
    }

    .brand-sub {
      font-size: 0.78rem;
      color: var(--text-muted);
    }

    .header-controls {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.6rem;
    }

    /* Stopwatch Widget */
    .timer-widget {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      background: var(--bg-subtle);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 0.32rem 0.6rem;
    }

    .timer-display {
      font-variant-numeric: tabular-nums;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 0.9rem;
      font-weight: 700;
      color: var(--text-primary);
      min-width: 68px;
      text-align: center;
    }

    .btn-sm {
      border: 1px solid var(--border-strong);
      background: var(--bg-card);
      color: var(--text-secondary);
      font-size: 0.78rem;
      font-weight: 600;
      padding: 0.3rem 0.6rem;
      border-radius: 6px;
      cursor: pointer;
      transition: all 0.15s ease;
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
    }

    .btn-sm:hover {
      background: var(--bg-hover);
      color: var(--text-primary);
    }

    .btn-primary {
      background: var(--accent);
      border-color: var(--accent);
      color: #ffffff;
    }

    .btn-primary:hover {
      background: var(--accent-hover);
      color: #ffffff;
    }

    .sync-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      font-size: 0.76rem;
      font-weight: 600;
      padding: 0.32rem 0.65rem;
      border-radius: 999px;
      background: var(--bg-subtle);
      border: 1px solid var(--border-color);
      color: var(--text-muted);
    }

    .sync-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #94a3b8;
    }

    .sync-badge.cloud-ok .sync-dot { background: #22c55e; }
    .sync-badge.syncing .sync-dot { background: #f59e0b; }
    .sync-badge.local-only .sync-dot { background: #3b82f6; }

    /* User Bar */
    .user-card {
      margin-top: 1.25rem;
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-lg);
      padding: 0.9rem 1.15rem;
      box-shadow: var(--shadow-sm);
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
    }

    .user-info-group {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.65rem;
      flex: 1;
    }

    .user-label {
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--text-secondary);
    }

    .input-field {
      padding: 0.45rem 0.75rem;
      border-radius: var(--radius-sm);
      border: 1px solid var(--border-strong);
      background: var(--bg-page);
      color: var(--text-primary);
      font-size: 0.88rem;
      outline: none;
      transition: border-color 0.15s ease;
    }

    .input-field:focus {
      border-color: var(--accent);
    }

    .user-input {
      min-width: 230px;
      max-width: 300px;
    }

    /* Dashboard Counters */
    .stats-grid {
      margin-top: 1rem;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0.85rem;
    }

    @media (max-width: 720px) {
      .stats-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    .stat-card {
      background: var(--bg-card);
      border: 2px solid var(--border-color);
      border-radius: var(--radius-lg);
      padding: 0.95rem 1.05rem;
      text-align: left;
      cursor: pointer;
      transition: all 0.15s ease;
      box-shadow: var(--shadow-sm);
      position: relative;
    }

    .stat-card:hover {
      transform: translateY(-1px);
      border-color: var(--border-strong);
      box-shadow: var(--shadow-md);
    }

    .stat-card.active {
      border-color: var(--accent);
      background: var(--accent-soft);
    }

    .stat-card.stat-correct.active {
      border-color: var(--green-border);
      background: var(--green-bg);
    }

    .stat-card.stat-wrong.active {
      border-color: var(--red-border);
      background: var(--red-bg);
    }

    .stat-title {
      font-size: 0.78rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--text-muted);
      margin-bottom: 0.25rem;
    }

    .stat-value {
      font-size: 1.55rem;
      font-weight: 800;
      color: var(--text-primary);
      line-height: 1.15;
    }

    .stat-card.stat-correct .stat-value { color: var(--green-text); }
    .stat-card.stat-wrong .stat-value { color: var(--red-text); }

    .stat-hint {
      font-size: 0.75rem;
      color: var(--text-muted);
      margin-top: 0.2rem;
    }

    /* Overall Progress Bar */
    .overall-progress-wrap {
      margin-top: 0.85rem;
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 0.75rem 1rem;
      box-shadow: var(--shadow-sm);
    }

    .progress-meta {
      display: flex;
      justify-content: space-between;
      font-size: 0.82rem;
      font-weight: 600;
      color: var(--text-secondary);
      margin-bottom: 0.45rem;
    }

    .dual-bar {
      height: 10px;
      width: 100%;
      background: var(--bg-subtle);
      border-radius: 999px;
      overflow: hidden;
      display: flex;
    }

    .dual-bar-green {
      height: 100%;
      background: var(--green-bar);
      transition: width 0.3s ease;
    }

    .dual-bar-red {
      height: 100%;
      background: var(--red-bar);
      transition: width 0.3s ease;
    }

    /* Topic Performance Panel */
    .panel-card {
      margin-top: 1rem;
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-sm);
      overflow: hidden;
    }

    .panel-header {
      padding: 0.9rem 1.15rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      cursor: pointer;
      user-select: none;
      background: var(--bg-card);
    }

    .panel-header:hover {
      background: var(--bg-subtle);
    }

    .panel-title {
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--text-primary);
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .panel-body {
      padding: 0.5rem 1.15rem 1.15rem;
      border-top: 1px solid var(--border-color);
      display: none;
    }

    .panel-body.open {
      display: block;
    }

    .topic-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
      gap: 0.65rem;
      margin-top: 0.5rem;
    }

    .topic-item {
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 0.7rem 0.85rem;
      background: var(--bg-page);
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .topic-item:hover {
      border-color: var(--accent);
      background: var(--accent-soft);
    }

    .topic-item.active {
      border-color: var(--accent);
      background: var(--accent-soft);
      box-shadow: 0 0 0 1px var(--accent);
    }

    .topic-item-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 0.5rem;
      margin-bottom: 0.35rem;
    }

    .topic-name {
      font-size: 0.84rem;
      font-weight: 700;
      color: var(--text-primary);
      line-height: 1.3;
    }

    .topic-count {
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--text-muted);
      white-space: nowrap;
    }

    .topic-stats-line {
      display: flex;
      justify-content: space-between;
      font-size: 0.75rem;
      font-weight: 600;
      margin-bottom: 0.35rem;
    }

    .txt-green { color: var(--green-text); }
    .txt-red { color: var(--red-text); }
    .txt-muted { color: var(--text-muted); }

    /* Filter Toolbar */
    .filter-toolbar {
      margin-top: 1rem;
      display: flex;
      flex-wrap: wrap;
      gap: 0.65rem;
      align-items: center;
    }

    .filter-toolbar select,
    .filter-toolbar input[type="search"] {
      flex: 1;
      min-width: 210px;
    }

    .active-filter-banner {
      margin-top: 0.85rem;
      padding: 0.65rem 1rem;
      border-radius: var(--radius-md);
      background: var(--accent-soft);
      border: 1px solid var(--accent);
      color: var(--text-primary);
      display: none;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 0.5rem;
      font-size: 0.86rem;
      font-weight: 600;
    }

    .active-filter-banner.visible {
      display: flex;
    }

    /* Question Cards */
    .questions-list {
      margin-top: 1.15rem;
      display: flex;
      flex-direction: column;
      gap: 1.15rem;
    }

    .q-card {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-lg);
      padding: 1.35rem;
      box-shadow: var(--shadow-sm);
      transition: border-color 0.2s ease;
    }

    .q-header {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
      margin-bottom: 0.85rem;
    }

    .q-badges {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.45rem;
    }

    .q-number {
      font-size: 0.8rem;
      font-weight: 800;
      padding: 0.22rem 0.6rem;
      border-radius: 6px;
      background: var(--accent-soft);
      color: var(--accent);
    }

    .q-topic-badge {
      font-size: 0.78rem;
      font-weight: 700;
      padding: 0.22rem 0.65rem;
      border-radius: 999px;
      background: var(--bg-subtle);
      border: 1px solid var(--border-color);
      color: var(--text-secondary);
    }

    .q-ref {
      font-size: 0.75rem;
      color: var(--text-muted);
    }

    .q-stem {
      font-size: 0.98rem;
      font-weight: 500;
      color: var(--text-primary);
      margin-bottom: 1.05rem;
      white-space: pre-line;
    }

    .options-list {
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
    }

    .option-btn {
      width: 100%;
      text-align: left;
      background: var(--bg-page);
      border: 1.5px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 0.8rem 1rem;
      cursor: pointer;
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 0.75rem;
      transition: all 0.15s ease;
      color: var(--text-primary);
      font-size: 0.93rem;
      line-height: 1.5;
    }

    .option-btn:hover:not(:disabled) {
      border-color: var(--accent);
      background: var(--accent-soft);
    }

    .option-btn:disabled {
      cursor: default;
    }

    .option-main {
      display: flex;
      align-items: flex-start;
      gap: 0.65rem;
      flex: 1;
    }

    .option-letter {
      width: 26px;
      height: 26px;
      border-radius: 7px;
      background: var(--bg-card);
      border: 1px solid var(--border-strong);
      font-size: 0.8rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      margin-top: 1px;
      color: var(--text-secondary);
    }

    /* Clean Answer States (NO line-through) */
    .option-btn.is-correct {
      background: var(--green-bg);
      border-color: var(--green-border);
      opacity: 1 !important;
    }

    .option-btn.is-correct .option-letter {
      background: var(--green-border);
      border-color: var(--green-border);
      color: #ffffff;
    }

    .option-btn.is-wrong-selected {
      background: var(--red-bg);
      border-color: var(--red-border);
      opacity: 1 !important;
    }

    .option-btn.is-wrong-selected .option-letter {
      background: var(--red-border);
      border-color: var(--red-border);
      color: #ffffff;
    }

    .option-btn.is-dimmed {
      opacity: 0.65;
    }

    .status-pill {
      font-size: 0.75rem;
      font-weight: 700;
      padding: 0.2rem 0.55rem;
      border-radius: 999px;
      white-space: nowrap;
      flex-shrink: 0;
    }

    .pill-correct {
      background: var(--green-border);
      color: #ffffff;
    }

    .pill-wrong {
      background: var(--red-border);
      color: #ffffff;
    }

    /* Justification Box */
    .justification-box {
      margin-top: 1rem;
      padding: 0.95rem 1.05rem;
      border-radius: var(--radius-md);
      background: var(--bg-subtle);
      border-left: 4px solid var(--accent);
      font-size: 0.9rem;
      color: var(--text-secondary);
    }

    .justification-title {
      font-weight: 700;
      color: var(--text-primary);
      margin-bottom: 0.3rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
    }

    .empty-state {
      text-align: center;
      padding: 3rem 1.5rem;
      background: var(--bg-card);
      border: 1px dashed var(--border-strong);
      border-radius: var(--radius-lg);
      color: var(--text-muted);
    }
  </style>
</head>
<body>

  <!-- Sticky Topbar -->
  <header class="topbar">
    <div class="topbar-inner">
      <div class="brand">
        <div class="brand-icon">SA</div>
        <div>
          <div class="brand-title">Simulado Saúde do Adulto</div>
          <div class="brand-sub">138 questões objetivas • 20 assuntos comentados</div>
        </div>
      </div>

      <div class="header-controls">
        <!-- Cronômetro -->
        <div class="timer-widget" title="Cronômetro de estudo">
          <span class="timer-display" id="timerDisplay">00:00:00</span>
          <button type="button" class="btn-sm btn-primary" id="timerToggleBtn">Iniciar</button>
          <button type="button" class="btn-sm" id="timerResetBtn">Zerar</button>
        </div>

        <!-- Status de Sincronização -->
        <div class="sync-badge local-only" id="syncBadge">
          <span class="sync-dot"></span>
          <span id="syncText">Salvo localmente</span>
        </div>

        <!-- Alternar Tema -->
        <button type="button" class="btn-sm" id="themeToggleBtn" aria-label="Alternar tema">
          🌙 Modo Escuro
        </button>
      </div>
    </div>
  </header>

  <main class="container">
    <!-- Identificação do Usuário -->
    <section class="user-card">
      <div class="user-info-group">
        <label for="userIdInput" class="user-label">Usuário / Matrícula:</label>
        <input
          type="text"
          id="userIdInput"
          class="input-field user-input"
          placeholder="Digite seu nome, e-mail ou matrícula..."
        />
        <button type="button" class="btn-sm btn-primary" id="saveUserBtn">Aplicar</button>
      </div>
      <div>
        <button type="button" class="btn-sm" id="resetAllBtn" style="color: var(--red-text); border-color: var(--red-border);">
          Resetar Progresso
        </button>
      </div>
    </section>

    <!-- Cards Clicáveis de Desempenho -->
    <section class="stats-grid" aria-label="Resumo de desempenho">
      <button type="button" class="stat-card active" data-status-filter="all" id="cardAll">
        <div class="stat-title">Total / Respondidas</div>
        <div class="stat-value" id="statAnswered">0 / 138</div>
        <div class="stat-hint">Clique para ver todas</div>
      </button>

      <button type="button" class="stat-card stat-correct" data-status-filter="correct" id="cardCorrect">
        <div class="stat-title">Acertos</div>
        <div class="stat-value" id="statCorrect">0</div>
        <div class="stat-hint" id="statCorrectPct">0% das respondidas</div>
      </button>

      <button type="button" class="stat-card stat-wrong" data-status-filter="wrong" id="cardWrong">
        <div class="stat-title">Erros</div>
        <div class="stat-value" id="statWrong">0</div>
        <div class="stat-hint" id="statWrongPct">0% das respondidas</div>
      </button>

      <button type="button" class="stat-card" data-status-filter="unanswered" id="cardUnanswered">
        <div class="stat-title">Não Respondidas</div>
        <div class="stat-value" id="statUnanswered">138</div>
        <div class="stat-hint">Filtrar pendentes</div>
      </button>
    </section>

    <!-- Barra Geral de Progresso -->
    <div class="overall-progress-wrap">
      <div class="progress-meta">
        <span id="overallProgressLabel">Progresso geral: 0% concluído</span>
        <span id="overallAccuracyLabel">Aproveitamento: —</span>
      </div>
      <div class="dual-bar">
        <div class="dual-bar-green" id="overallGreenBar" style="width: 0%;"></div>
        <div class="dual-bar-red" id="overallRedBar" style="width: 0%;"></div>
      </div>
    </div>

    <!-- Painel Colapsável: Desempenho por Assunto -->
    <section class="panel-card">
      <div class="panel-header" id="topicPanelToggle">
        <div class="panel-title">
          <span>📊 Desempenho Detalhado por Assunto (20 tópicos)</span>
        </div>
        <span class="btn-sm" id="topicPanelArrow">Mostrar ▼</span>
      </div>
      <div class="panel-body" id="topicPanelBody">
        <p style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 0.4rem;">
          Clique em qualquer assunto abaixo para filtrar imediatamente as questões daquele tema.
        </p>
        <div class="topic-grid" id="topicBreakdownGrid"></div>
      </div>
    </section>

    <!-- Barra de Busca e Filtro por Assunto -->
    <section class="filter-toolbar">
      <select id="topicSelect" class="input-field" aria-label="Filtrar por assunto">
        <option value="all">Todos os Assuntos (138 questões)</option>
      </select>
      <input
        type="search"
        id="searchInput"
        class="input-field"
