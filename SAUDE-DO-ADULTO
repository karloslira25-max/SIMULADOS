    function setSyncStatus(state, label) {
      syncBadge.className = `sync-badge ${state}`;
      syncText.textContent = label;
    }

    function storageKey() {
      return `${QUIZ_ID}_${userId}`;
    }

    function loadLocalProgress() {
      try {
        const raw = localStorage.getItem(storageKey());
        userProgress = raw ? JSON.parse(raw) : {};
      } catch (e) {
        userProgress = {};
      }
    }

    function saveLocalProgress() {
      localStorage.setItem(storageKey(), JSON.stringify(userProgress));
    }

    async function syncFromCloud() {
      const url = getScriptUrl();
      if (!url) {
        setSyncStatus("local-only", "Salvo localmente");
        return;
      }
      setSyncStatus("syncing", "Sincronizando...");
      try {
        const resp = await fetch(`${url}?userId=${encodeURIComponent(userId)}&quizId=${encodeURIComponent(QUIZ_ID)}`);
        const data = await resp.json();
        if (data && data.status === "ok" && data.progress && typeof data.progress === "object") {
          userProgress = { ...userProgress, ...data.progress };
          saveLocalProgress();
          renderAll();
        }
        setSyncStatus("cloud-ok", "Salvo na nuvem");
      } catch (err) {
        setSyncStatus("local-only", "Salvo localmente");
      }
    }

    async function syncToCloud() {
      saveLocalProgress();
      const url = getScriptUrl();
      if (!url) {
        setSyncStatus("local-only", "Salvo localmente");
        return;
      }
      setSyncStatus("syncing", "Salvando na nuvem...");
      try {
        const resp = await fetch(url, {
          method: "POST",
          headers: { "Content-Type": "text/plain;charset=utf-8" },
          body: JSON.stringify({
            userId: userId,
            quizId: QUIZ_ID,
            progress: userProgress
          })
        });
        const data = await resp.json();
        if (data && data.status === "ok") {
          setSyncStatus("cloud-ok", "Salvo na nuvem");
        } else {
          setSyncStatus("local-only", "Salvo localmente");
        }
      } catch (err) {
        setSyncStatus("local-only", "Salvo localmente");
      }
    }

